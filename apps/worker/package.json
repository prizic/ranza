{
  "name": "@ranza/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.mjs --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --external:@prisma/client --external:@nestjs/microservices --external:@nestjs/websockets --external:@nestjs/platform-express --external:class-transformer --external:class-validator",
    "dev": "pnpm build && node --enable-source-maps dist/main.mjs",
    "lint": "eslint src",
    "start": "node dist/main.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/schedule": "12.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@ranza/db": "workspace:*",
    "@ranza/platform-outbox": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "type": "module"
}
