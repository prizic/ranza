.superpowers/
.scratch/
.worktrees/
.env*
!.env.example
# Local development defaults, committed on purpose. `pnpm dev` loads it before
# anything starts, it cannot override a variable that is already set, and every
# value in it works against localhost:54322 and nowhere else. Gitignoring it
# would mean a fresh clone has a dev server that does not start.
!.env.development
node_modules/
.next/
.turbo/
coverage/
playwright-report/
test-results/
.playwright-mcp/
dist/
.vercel/
*.tsbuildinfo
supabase/.branches/
supabase/.temp/
.DS_Store
.mcp.json
packages/db/generated/
packages/db/dist/
# Regenerated by every `next build`, and it references .next/ which is ignored.
apps/*/next-env.d.ts

# Vendored agent tooling (ECC and installed skills). Reinstallable, not source.
# Everything under .claude/ is ignored except what this repository owns and
# commits. Those survive `npx ecc-universal install`; everything else is
# replaced by it, so a rule written into a vendored file is reviewed by nobody
# and gone by the next install.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/feature-design/
dev-smoke.log

!.claude/skills/ranza-review/
!.claude/agents/
.claude/agents/*
!.claude/agents/ranza-reviewer.md

# nodeterm canvas state for whoever runs this repository on that tool. Local, not source.
.nodeterm/

# Per-machine credentials for hosted environments. Never committed.
CLAUDE.local.md

# Rendered by `pnpm decisions` from docs/features/*/edge-cases.csv. The tables
# are the record; a committed copy would be stale between regenerations.
docs/decisions.html
