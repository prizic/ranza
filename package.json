{
  "name": "ranza",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:docs": "node scripts/docs-check.mjs",
    "check:edge-cases": "node scripts/edge-cases-check.mjs",
    "db:down": "docker compose down",
    "db:drift": "node scripts/db-drift.mjs",
    "db:migrate": "pnpm --filter @ranza/db exec prisma migrate deploy --schema ../../prisma/schema.prisma --config ../../prisma.config.ts",
    "db:migrate:new": "pnpm --filter @ranza/db exec prisma migrate dev --create-only --schema ../../prisma/schema.prisma --config ../../prisma.config.ts",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:setup",
    "db:seed:dev": "node scripts/db-seed-dev.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "db:test": "node scripts/db-test.mjs",
    "db:up": "docker compose up -d --wait",
    "decisions": "node scripts/decisions-register.mjs",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "turbo run lint && pnpm lint:boundaries",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs packages apps",
    "test": "pnpm test:unit && pnpm test:boundaries && pnpm check:docs && pnpm check:edge-cases",
    "test:boundaries": "node scripts/dependency-boundaries.mjs",
    "test:browser": "playwright test",
    "test:integration": "vitest run --config vitest.integration.mts",
    "test:unit": "vitest run",
    "typecheck": "turbo run typecheck",
    "dev:smoke": "node scripts/dev-smoke.mjs"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.0.0",
    "globals": "17.12.0",
    "jsdom": "^30.0.1",
    "next-intl": "^4.14.5",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
