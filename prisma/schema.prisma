// Prisma owns schema migrations (ADR 0001). Row-level security policies,
// security-definer functions, and grants are hand-written SQL appended into the
// same migration that creates the objects they protect — Prisma does not model
// them, so they must never be regenerated away.
//
// Generate with `prisma migrate dev --create-only`, add the policy SQL, then apply.

generator client {
  provider        = "prisma-client"
  previewFeatures = ["partialIndexes"]
  // Generated into the package that owns database access, so it resolves
  // @prisma/client from there rather than the workspace root.
  output          = "../packages/db/generated/prisma"
}

// Prisma 7 moved connection URLs out of the schema. Migrations read DIRECT_URL
// from prisma.config.ts; the runtime client is constructed with a pg driver
// adapter over the pooled URL. See ADR 0001.
datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities  AuthIdentity[]
  memberships OrganizationMembership[]
  assignments PropertyAssignment[]
  stays       Stay[]
  invitesSent StaffInvitation[]        @relation("StaffInvitationAuthor")

  @@map("users")
}

/// Maps an authentication provider's subject onto a Ranza user (ADR 0005).
/// Keyed on (issuer, subject); never on email, which changes.
model AuthIdentity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  issuer    String
  subject   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([issuer, subject])
  @@index([userId], map: "auth_identities_user_idx")
  @@map("auth_identities")
}

model Organization {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  status        String   @default("pending")
  defaultLocale String   @default("tr") @map("default_locale")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  properties   Property[]
  memberships  OrganizationMembership[]
  subscription Subscription?
  entitlements Entitlement[]
  guests       Guest[]
  staffRoles   StaffRole[]

  @@map("organizations")
}

model Property {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  status         String   @default("active")
  timezone       String   @default("Europe/Istanbul")
  /// The currency this Property trades in, ISO 4217. Alongside `timezone` and
  /// for the same reason: an Organization may hold Properties in more than one
  /// country, so neither fact can live one level up. A Folio copies it at the
  /// moment it opens.
  currency       String   @default("TRY") @db.Char(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignments  PropertyAssignment[]
  capabilities PropertyCapability[]
  units        AccommodationUnit[]
  stays        Stay[]
  reservations Reservation[]
  folios       Folio[]

  @@unique([id, organizationId])
  @@index([organizationId], map: "properties_organization_idx")
  @@map("properties")
}

/// A sellable or assignable space inside a Property (blueprint 2, 5.2).
///
/// Carries organization_id alongside property_id so the composite foreign key
/// proves the pair belongs together — a Unit cannot be attached to another
/// Organization's Property. The second composite key exists so a Stay can carry
/// all three and prove the same thing about itself.
model AccommodationUnit {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// The Unit this one is inside. Null for a room; a bed's room (ADR 0025).
  /// Only a bed has one, and only a room may be one — a check constraint says
  /// the first half and the composite foreign key below proves the second.
  parentId       String?  @map("parent_id") @db.Uuid
  /// The parent's own `unit_type`, denormalized for the same reason
  /// `organization_id` is: a foreign key can then prove the claim, where a
  /// check constraint could only look at this row. Null exactly when
  /// `parent_id` is.
  parentUnitType String?  @map("parent_unit_type")
  name           String
  unitType       String   @map("unit_type")
  /// Where the Unit is, for grouping and filtering. Columns rather than Units
  /// of their own: blueprint 5.2 lists buildings, floors and Accommodation
  /// Units as three things, and nothing addresses a floor as a record (ADR 0025).
  building       String?
  floor          Int?
  /// How many people this Unit sleeps. A bed sleeps one, which is constrained;
  /// the rest is a fact rather than a rule until a Stay records its occupants.
  capacity       Int      @default(1)
  status         String   @default("available")
  /// Why the Unit is blocked, in the words of whoever blocked it. Present
  /// exactly when `status` is `blocked`: a check constraint says so, and the
  /// audit record keeps the history of it.
  statusReason   String?  @map("status_reason")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  property     Property            @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)
  parent       AccommodationUnit?  @relation("UnitNesting", fields: [parentId, propertyId, organizationId, parentUnitType], references: [id, propertyId, organizationId, unitType], onDelete: Restrict, onUpdate: NoAction)
  children     AccommodationUnit[] @relation("UnitNesting")
  stays        Stay[]
  reservations Reservation[]
  housekeeping HousekeepingUnitStatus[]

  /// A room's name is unique in its Property; a bed's is unique in its room.
  /// Two partial indexes rather than one over `(property_id, parent_id, name)`,
  /// because null is not equal to null in a unique index and that version would
  /// silently stop constraining rooms at all (ADR 0025).
  @@unique([propertyId, name], map: "accommodation_units_property_id_name_key", where: raw("parent_id IS NULL"))
  @@unique([parentId, name], map: "accommodation_units_parent_id_name_key", where: raw("parent_id IS NOT NULL"))
  @@unique([id, propertyId, organizationId])
  /// What the nesting foreign key resolves against, so "my parent is a room" is
  /// proved rather than asserted.
  @@unique([id, propertyId, organizationId, unitType], map: "accommodation_units_nesting_key")
  @@index([parentId], map: "accommodation_units_parent_idx")
  @@map("accommodation_units")
}

/// Whether a room needs cleaning (blueprint 5.4, 18.2; ADR 0029). One row per
/// status holder: a Unit with no parent, so a bed under a room answers to the
/// room and a bed with no room holds its own. A holder with no row reads as
/// clean. Whether a Unit is in service is `accommodation_units.status`, a
/// different lifecycle that coexists with this one.
model HousekeepingUnitStatus {
  accommodationUnitId String   @id @map("accommodation_unit_id") @db.Uuid
  propertyId          String   @map("property_id") @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  status              String
  /// When the status last changed, stamped by the database rather than stated
  /// by the caller. What a departure compares against: a status changed after
  /// the Guest left is kept.
  statusChangedAt     DateTime @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  /// The Staff Member who changed it, stamped by the database. Null when a
  /// departure did. No foreign key, for the reason `audit.records.actor_id`
  /// has none: who acted is history, not a live reference.
  statusChangedBy     String?  @map("status_changed_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  unit AccommodationUnit @relation(fields: [accommodationUnitId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: NoAction)

  @@index([propertyId, status])
  @@map("housekeeping_unit_status")
}

/// A named set of permissions (blueprint 7.2). A role is not a label: what a
/// Staff Member may do is the set, and a new set is a new role with a name of
/// its own.
///
/// `organizationId` is null for the roles Ranza ships. Every Organization sees
/// those and none may edit or retire one; an Organization's own roles are
/// invisible to every other. A nullable column cannot carry a foreign key, so
/// `scopeId` restates the same fact as the Organization or the nil uuid, and it
/// is `scopeId` that a membership's composite key resolves against — which is
/// what makes another Organization's role unrepresentable rather than checked.
/// What a role may be composed from: every command the product has, as a row.
///
/// Ranza ships this table and an Organization never writes to it — a permission
/// is a command that exists in a release, so inventing one would be inventing a
/// command. `staff_roles.permissions` is validated against it by a trigger,
/// because an array element cannot carry a foreign key and the array is read
/// inside every write policy on every row.
model StaffPermission {
  key       String   @id
  moduleKey String   @map("module_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("staff_permissions")
}

model StaffRole {
  scopeId        String   @map("scope_id") @db.Uuid
  key            String
  /// Not the key and not what anything references — the composite stays,
  /// because it is what makes another Organization's role unrepresentable.
  /// This exists for `audit.records`, which takes an opaque uuid subject and
  /// nothing else; naming the Organization instead would be an audit trail
  /// recording the wrong subject.
  id             String   @unique(map: "staff_roles_id_key") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  name           String
  permissions    String[] @default([])
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  memberships  OrganizationMembership[]

  @@id([scopeId, key])
  @@unique([scopeId, name], map: "staff_roles_scope_name_key")
  @@map("staff_roles")
}

model OrganizationMembership {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// The role's key. Meaningful only together with `roleScopeId`, which says
  /// whether it is one Ranza ships or one this Organization authored.
  role           String
  roleScopeId    String    @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @map("role_scope_id") @db.Uuid
  accessScope    String    @default("assigned_properties") @map("access_scope")
  status         String    @default("active")
  /// When they set a password. Null while an invitation is outstanding — the
  /// membership is active either way, because it was never waiting on it.
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  /// What the 24-hour undo window is measured from, and the reason a revoked
  /// membership is a resting state rather than a deletion.
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  staffRole    StaffRole         @relation(fields: [roleScopeId, role], references: [scopeId, key], onDelete: Restrict, onUpdate: NoAction, map: "organization_memberships_role_fkey")
  invitations  StaffInvitation[]

  @@unique([organizationId, userId])
  // Partial: only an active membership is ever looked up by user.
  @@index([userId], map: "organization_memberships_user_idx", where: raw("status = 'active'"))
  @@map("organization_memberships")
}

/// The way to a password, and nothing else. The membership it belongs to is
/// active from the moment it is written, so an invitation grants no reach and
/// losing one costs nobody their job.
///
/// Only the SHA-256 digest is stored. The plaintext is returned once, to
/// whoever created the invitation, because there is no Notifications module to
/// send it (blueprint 5.12) and a table of live credentials is not the price of
/// that gap.
model StaffInvitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  status         String    @default("pending")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  invitedBy      String    @map("invited_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: NoAction)
  author     User                   @relation("StaffInvitationAuthor", fields: [invitedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// Several over time, at most one of them live: re-inviting writes a fresh
  /// one against the same membership.
  @@unique([organizationId, userId], map: "staff_invitations_pending_key", where: raw("status = 'pending'"))
  @@index([organizationId], map: "staff_invitations_organization_idx")
  @@map("staff_invitations")
}

model PropertyAssignment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  status         String    @default("active")
  /// An assignment is revoked, never deleted: the row is the record that they
  /// used to reach this Property.
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([propertyId, userId])
  // Partial: a revoked assignment is history, never a reach.
  @@index([userId], map: "property_assignments_user_idx", where: raw("status = 'active'"))
  @@map("property_assignments")
}

/// A person a Reservation or a Stay is for (blueprint section 2). A Guest is
/// short-term and a Resident is long-term; both are people, and this is the
/// person rather than the stay.
///
/// Owned by an **Organization** rather than by a Property, which is the one
/// place this table breaks the pattern every other tenant-owned row follows —
/// see ADR 0024. Everything a Guest exists for beyond one booking (a history
/// across two Stays, duplicate review, a document, a guardian; blueprint 18.7)
/// is an Organization-wide question, and a Property-scoped Guest could not
/// answer any of it without a merge later.
///
/// Not a Ranza user. Somebody is booked in long before they sign in and most
/// never do; `stays.user_id` is the separate, nullable fact that gives one a
/// Portal (ADR 0009).
model Guest {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fullName       String   @map("full_name")
  /// Stored trimmed and lowercased — `guests_email_is_normalized` requires it,
  /// because the partial unique below is over the stored value and two
  /// spellings of one address is exactly the duplicate this table exists to
  /// avoid. Null when the front desk was given none, which is normal.
  email          String?
  phone          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reservations Reservation[]

  /// What a Reservation's composite foreign key resolves against, so a
  /// Reservation naming another Organization's Guest is unrepresentable rather
  /// than merely checked.
  @@unique([id, organizationId])
  /// An exact address within one Organization is one person. Partial, because
  /// a Guest with no email is not a key and must not collide with the next
  /// person who also gave none — and because guessing that two of them are the
  /// same is the automatic merge blueprint 18.7 forbids.
  @@unique([organizationId, email], map: "guests_organization_email_key", where: raw("email IS NOT NULL"))
  @@index([organizationId], map: "guests_organization_idx")
  @@map("guests")
}

/// A planned allocation of an Accommodation Unit for a period, which may become
/// a Stay through check-in (blueprint 2, 5.3).
///
/// Carries the same composite foreign keys as every other Property-scoped row,
/// so a Reservation pointing at another Organization's Property or Unit is
/// unrepresentable rather than merely checked.
///
/// This is the first table the runtime role may write to. What bounds that
/// write is a policy with a WITH CHECK rather than an application check — see
/// ADR 0012, and the migration that owns this table.
model Reservation {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  propertyId          String    @map("property_id") @db.Uuid
  accommodationUnitId String    @map("accommodation_unit_id") @db.Uuid
  /// Who the allocation is for. A Guest record rather than a name, so two
  /// bookings for one person are one person — which is what lets a Stay have a
  /// history and what `guest_name` could not express.
  guestId             String    @map("guest_id") @db.Uuid
  /// Which kind of Stay a check-in would produce. Short-term is a Guest,
  /// long-term is a Resident; both are Stays (ADR 0004).
  stayType            String    @map("stay_type")
  status              String    @default("requested")
  startsOn            DateTime  @map("starts_on") @db.Date
  endsOn              DateTime? @map("ends_on") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property          @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)
  unit     AccommodationUnit @relation(fields: [accommodationUnitId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: NoAction)
  guest    Guest             @relation(fields: [guestId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)
  /// Several, of which at most one is not cancelled. A withdrawn check-in keeps
  /// its `reservation_id` so the mistake stays visible (ADR 0022), and the
  /// partial unique on `stays` is what stops a second live one.
  stays    Stay[]

  @@unique([id, propertyId, organizationId])
  @@index([propertyId, startsOn], map: "reservations_property_arrival_idx")
  @@index([guestId], map: "reservations_guest_idx")
  @@map("reservations")
}

/// The operational record connecting a Guest or Resident to an Accommodation
/// Unit for a period (blueprint 2, 5.3). A Guest is short-term and a Resident
/// long-term; both are Stays, told apart by `stay_type`.
///
/// `user_id` is the Ranza user the Stay belongs to and is what the Resident
/// access path resolves against (ADR 0009). It is nullable because most Stays
/// are created by Staff for someone who has never signed in — a Stay with no
/// user simply has no portal, which is a normal state and not a broken row.
model Stay {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  propertyId          String    @map("property_id") @db.Uuid
  accommodationUnitId String    @map("accommodation_unit_id") @db.Uuid
  /// The Reservation this Stay was checked in from, when there was one. Null
  /// for a Stay that began without one, such as a walk-in. The partial unique
  /// below makes being checked in twice *at once* unrepresentable, while
  /// leaving a withdrawn check-in able to arrive again.
  reservationId       String?   @map("reservation_id") @db.Uuid
  userId              String?   @map("user_id") @db.Uuid
  stayType            String    @map("stay_type")
  status              String    @default("reserved")
  startsOn            DateTime  @map("starts_on") @db.Date
  endsOn              DateTime? @map("ends_on") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  property    Property          @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)
  unit        AccommodationUnit @relation(fields: [accommodationUnitId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: NoAction)
  user        User?             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reservation Reservation?      @relation(fields: [reservationId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: NoAction)
  folio       Folio?

  // The composite foreign key above forces property and organization to be the
  // Reservation's own, so uniqueness across the three is uniqueness on
  // reservation_id alone: one Reservation has at most one Stay that is not
  // cancelled.
  //
  // Partial on status, because ADR 0022 withdraws a check-in by cancelling the
  // Stay and returning the Reservation to `confirmed` precisely so the Guest can
  // arrive again. A total unique index made that door one-way — the cancelled
  // Stay went on holding the Reservation and the second check-in collided with
  // it (issue #34). Cancelled rows are excluded rather than removed, so the
  // mistake stays on the record.
  @@unique([reservationId, propertyId, organizationId], where: { status: { not: "cancelled" } })
  // What a Folio's composite foreign key resolves against, so a Folio pointing
  // at another Organization's Stay is unrepresentable rather than merely
  // checked. The primary key alone could not prove the Property or the
  // Organization.
  @@unique([id, propertyId, organizationId])
  @@index([propertyId], map: "stays_property_idx")
  // Partial: the Resident access path only ever asks about a current Stay.
  @@index([userId], map: "stays_user_idx", where: raw("status = ANY (ARRAY['reserved'::text, 'in_house'::text])"))
  @@map("stays")
}

model Subscription {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  status         String   @default("trialing")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("subscriptions")
}

model Entitlement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  moduleKey      String   @map("module_key")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, moduleKey])
  @@map("entitlements")
}

model PropertyCapability {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  capabilityKey  String   @map("capability_key")
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([propertyId, capabilityKey])
  @@map("property_capabilities")
}

/// The financial record collecting charges, credits, taxes, adjustments and
/// payments for a Stay (blueprint 2, 5.9).
///
/// A Folio holds no total. Its balance is the sum of its lines and nothing
/// else, because a stored total is a second source of truth that drifts — see
/// ADR 0015 and the migration that owns this table.
///
/// `currency` is copied from the Property when the Folio opens, by a statement
/// that reads the Property rather than trusting its caller. The lines carry no
/// currency of their own: a line that could disagree with its Folio would make
/// the sum meaningless.
model Folio {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  stayId         String    @map("stay_id") @db.Uuid
  currency       String    @db.Char(3)
  status         String    @default("open")
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property    @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)
  stay     Stay        @relation(fields: [stayId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: NoAction)
  lines    FolioLine[]

  @@unique([id, propertyId, organizationId])
  /// One Folio per Stay in this slice. Split folios are blueprint 5.9 and are
  /// not built, so this states that rather than leaving the question open.
  /// Because the composite foreign key above forces property and organization
  /// to be the Stay's own, uniqueness across the three is uniqueness on
  /// stay_id alone — the same argument `stays_reservation_id_...` already makes.
  @@unique([stayId, propertyId, organizationId])
  @@index([propertyId, status], map: "folios_property_status_idx")
  @@map("folios")
}

/// One posted line on a Folio. Append-only: never updated, never deleted.
///
/// A correction is a further line referencing the one it corrects, which is
/// what blueprint 7.4 requires of financial history. The policies, the grants
/// and a trigger each say so independently, because the audit module has
/// already been wrong about exactly this once.
model FolioLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  folioId        String   @map("folio_id") @db.Uuid
  /// `charge` or `reversal`. Nothing else: payments, credits, deposits and
  /// refunds are blueprint 5.9 workflows this slice does not build, and a value
  /// invented for one of them would be inventing the workflow.
  lineType       String   @map("line_type")
  description    String
  /// Integer minor units, signed. Never a float, and never scaled by a
  /// fraction — the unit is whatever the Folio's currency calls its hundredth.
  amountMinor    BigInt   @map("amount_minor")
  /// The line this one reverses, null on an original charge.
  reversesLineId String?  @map("reverses_line_id") @db.Uuid
  postedAt       DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)

  folio    Folio      @relation(fields: [folioId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: NoAction)
  reverses FolioLine? @relation("FolioLineReversal", fields: [reversesLineId, folioId], references: [id, folioId], onDelete: Restrict, onUpdate: NoAction)
  reversal FolioLine? @relation("FolioLineReversal")

  /// What the reversal's composite foreign key resolves against, so a reversal
  /// cannot reference a line on a different Folio.
  @@unique([id, folioId])
  /// A charge is reversed at most once. The foreign key forces folio_id to be
  /// the reversed line's own, so uniqueness across the pair is uniqueness on
  /// reverses_line_id alone.
  @@unique([reversesLineId, folioId])
  @@index([folioId, postedAt], map: "folio_lines_folio_idx")
  @@map("folio_lines")
}

// --- Better Auth -----------------------------------------------------------
// Owned by Better Auth and reached only through the ranza_auth role. Prefixed
// auth_ so `auth_user` is never confused with Ranza's `users`, which is what
// policies resolve against. Column names are Better Auth's and are quoted in
// the migration because it expects camelCase.

model AuthUser {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  /// Set by Better Auth only after a TOTP code has been verified, never on
  /// enrolment — an unverified secret must not be able to lock anyone out.
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  sessions  AuthSession[]
  accounts  AuthAccount[]
  twoFactor AuthTwoFactor[]

  @@map("auth_user")
}

/// The second factor: a TOTP secret and single-use backup codes.
///
/// The most sensitive table in the system after auth_account. Better Auth
/// encrypts `secret` and `backupCodes` with BETTER_AUTH_SECRET before they are
/// stored, so reading the row is not immediately enough — but the tenant query
/// path is granted nothing here regardless, exactly as with password hashes.
model AuthTwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(6)

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "auth_two_factor_user_idx")
  @@map("auth_two_factor")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "auth_session_user_idx")
  @@map("auth_session")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "auth_account_user_idx")
  @@map("auth_account")
}

/// Rate-limit counters, shared across every server instance.
///
/// Better Auth defaults to counting in process memory, which on a deployment
/// with more than one instance means each instance enforces its own limit and
/// an attacker spread across them gets a multiple of it. Blueprint 7.6 lists
/// rate limiting in the security baseline, so the counter lives where every
/// instance can see it.
model AuthRateLimit {
  id          String @id
  key         String @unique
  count       Int
  /// Epoch milliseconds. Bigint because it does not fit in a 32-bit integer.
  lastRequest BigInt

  @@map("auth_rate_limit")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([identifier], map: "auth_verification_identifier_idx")
  @@map("auth_verification")
}
