%% Slices decide implementation order and nothing else:
%%   s1 the read: one figure set per Property the viewer reaches, gates asked once per Property
%%   s2 the screen: All Properties, drawn from the s1 read and nothing else (rows PF-S2-*, proposed)
%% A flowchart rather than usecase-beta: see .claude/skills/feature-design/SKILL.md step b.
%% Refusals and empty answers are rows in edge-cases.csv, not use cases.
flowchart TD

  OWNER["Staff Member reaching every Property<br/>(organization_wide, e.g. Owner)"]
  MANAGER["Staff Member reaching some Properties<br/>(assigned_properties, e.g. Manager)"]
  DESK["Staff Member reaching one Property<br/>without finance.manage_folio"]
  OUTSIDER["Staff Member of another Organization,<br/>or a Resident"]

  subgraph S1["slice 1 &mdash; the portfolio read"]
    LIST(["Read one row per reached Property<br/>in one call, one snapshot"])
    OPS(["Read operational figures<br/>occupied and sellable units, arrivals and departures<br/>still to come, open maintenance requests"])
    MONEY(["Read open folio balance<br/>per Property, per currency"])
    MASK(["Mask money<br/>for a reader without finance.manage_folio"])
    WITHHOLD(["Show a reached Property as withheld<br/>when its capability is off"])
    ABSENT(["Leave out a Property the reader<br/>does not reach or that is archived"])
    TOTAL(["Total occupancy across the rows<br/>as summed counts, never a percentage"])
    OWNDAY(["Evaluate each Property on its own business date"])
    REPORT(["Record portfolio.viewed<br/>actor, Property count, outcome"])
  end

  subgraph OUT["Not this feature"]
    CHARGED(["Charged this month &mdash; deferred, needs a definition"])
    TREND(["Occupancy trend line &mdash; deferred, mockup data is invented"])
    CONVERT(["A money total across currencies &mdash; deferred"])
    CLOSED(["A closed Property's history for the Owner &mdash; deferred, ADR 0040"])
  end

  subgraph S2["slice 2 &mdash; the All Properties screen"]
    OFFER(["Offer the destination<br/>only to a viewer reaching several Properties of one Organization"])
    COMPARE(["Set the Properties side by side<br/>one card each, three summary figures, as-of stamp"])
    SAYHIDDEN(["Say what is hidden or unavailable<br/>never show it as zero"])
    OPEN(["Open a Property<br/>remember it, then Today at it"])
    ONE(["Say there is nothing to compare<br/>when only one Property is reached"])
    REFUSED(["Say the portfolio is too large<br/>when more than the ceiling is reached"])
  end

  OWNER --> LIST
  MANAGER --> LIST
  DESK --> LIST
  OUTSIDER -. refuses .-> LIST

  LIST -. include .-> OWNDAY
  LIST -. include .-> OPS
  LIST -. include .-> ABSENT
  LIST -. include .-> REPORT
  LIST -. extend .-> TOTAL
  LIST -. extend .-> MONEY
  LIST -. extend .-> WITHHOLD
  MONEY -. include .-> MASK

  OWNER --> OFFER
  MANAGER --> OFFER
  OFFER --> COMPARE
  COMPARE -. include .-> LIST
  COMPARE -. include .-> SAYHIDDEN
  COMPARE -. extend .-> OPEN
  OFFER -. extend .-> ONE
  COMPARE -. extend .-> REFUSED
