%% Slices decide implementation order and nothing else:
%%   s1 zero-balance check-out   s2 leave a Folio open   s3 reverse   s4 subscription exit paths
%% A flowchart rather than usecase-beta: see .claude/skills/feature-design/SKILL.md step b.
%% UML directions: include points base --> included. extend points extension --> base.
%% Refusals and contention are test cases, not use cases: they are rows in edge-cases.csv.
%% State transitions are in states.mmd and are deliberately not repeated here.
flowchart TD

  SM["Staff Member<br/>check_out"]
  MGR["Manager or night auditor<br/>every permission an agent has, and more"]

  subgraph S4["slice 4 &mdash; subscription exit paths"]
    EXIT(["Check out while the Subscription is suspended<br/>commercial gates relaxed<br/>permission and reach still required"])
  end

  subgraph S2["slice 2 &mdash; leave a Folio open"]
    OPENCR(["Leave the Folio open, credit<br/>folio.leave_open_credit"])
    OPENDR(["Leave the Folio open, debit<br/>folio.leave_open_debit"])
    REVIEWLIST(["Review flagged open Folios"])
  end

  subgraph S1["slice 1 &mdash; zero-balance check-out"]
    EARLY(["Acknowledge early departure"])
    RESIDENT(["Check out an open-ended Stay"])
    WALKIN(["Check out a Stay with no Reservation"])
    CONFIRM(["Confirm check-out"])
    REVIEW(["Review check-out"])
  end

  subgraph S3["slice 3 &mdash; reverse"]
    REVERSE(["Reverse check-out<br/>check_out.reverse, reason required"])
  end

  subgraph OUT["Not this feature"]
    SETTLE(["Settle a Folio &mdash; prerequisite"])
    CLOSEF(["Close a Folio &mdash; prerequisite"])
    FIN(["Write off, refund &mdash; Finance"])
    MOVEOUT(["Resident move-out &mdash; its own feature"])
    HK(["Housekeeping consumes stay.checked_out<br/>and stay.check_out_reversed"])
  end

  EXIT -- "extend" --> CONFIRM
  OPENCR -- "extend" --> CONFIRM
  OPENDR -- "extend" --> CONFIRM
  EARLY -- "extend" --> CONFIRM
  RESIDENT -- "extend" --> CONFIRM
  WALKIN -- "extend" --> CONFIRM
  CONFIRM -- "include" --> REVIEW

  SM --> CONFIRM
  SM --> REVERSE
  MGR --> REVIEWLIST
  MGR -- "generalizes (is a Staff Member)" --> SM

  CONFIRM -. "depends on" .-> OUT

