%% Slices decide implementation order and nothing else:
%%   s1 the calendar, read-only, every view option in the URL
%%   s2 Property defaults for that view, an Organization default and a Property override
%%   s3 move a bar by dragging it, on the commands of ADR 0039, and filter by Unit type and state
%% A flowchart rather than usecase-beta: see .claude/skills/feature-design/SKILL.md step b.
%% UML directions: include points base --> included. extend points extension --> base.
%% Refusals and contention are test cases, not use cases: they are rows in edge-cases.csv.
%% How a bar changes is in states.mmd and is deliberately not repeated here.
%% Where it lives: under Front Office, after Reservations, gated by the front_desk
%% capability like Arrivals, Departures and Rooms & beds. The calendar writes nothing of its
%% own: a drag only proposes, and the commands of ADR 0039 (amend a booking, change a
%% departure, move a Guest) check the caller and decide, so a move is still refused by a
%% column grant for anything that is not one of them. It shows an overlap - an in-house Stay and a confirmed
%% Reservation holding the same night - rather than hiding it; since #60 one
%% arises only by a Guest staying past their date, or from rows written before.
flowchart TD

  DESK["Staff Member reaching the Property<br/>with the front_desk capability"]
  SETTER["Staff Member holding accommodation.configure<br/>sets the calendar defaults"]
  RESIDENT["Resident<br/>reaches their own Stay and no further (ADR 0009)"]

  subgraph S1["slice 1 &mdash; the calendar"]
    READ(["Read the calendar<br/>rooms and beds against a window of days"])
    BARS(["See each booking and Stay as a bar<br/>requested, confirmed, in house, overdue, departed"])
    FREE(["Read how many Units are free each night"])
    OVERLAPS(["Count overlaps across the whole Property<br/>whatever the filters hide"])
    BLOCKS(["See a blocked or out-of-service Unit<br/>from today on, with its reason"])
    WINDOW(["Change the window<br/>7, 14 or 30 days, previous, next, today, a chosen date"])
    SHAPE(["Change what is shown<br/>floor, requested, departed, search, beds collapsed"])
    ONLYOVER(["Show only the Units with an overlap"])
    DETAIL(["Open a bar<br/>Guest or Resident, booked and actual dates,<br/>room and bed, balance of a Stay"])
    ONWARD(["Go where the command lives<br/>Arrivals, Departures, Reservations"])
    LIVE(["Refresh while open<br/>every 30 seconds, paused when hidden"])
    REMEMBER(["Open with the view last used<br/>in this browser"])
  end

  subgraph S2["slice 2 &mdash; Property defaults"]
    SETDEF(["Set the default view<br/>for the Organization, and override it per Property"])
    OPENDEF(["Open with the Property's default view<br/>a residence at 30 days with beds shown"])
  end

  subgraph S3["slice 3 &mdash; move a bar"]
    DRAG(["Drag a booking to another Unit or other days,<br/>or pull its end"])
    DRAGGUEST(["Drag a Guest in house to another room,<br/>or pull the end of their stay"])
    PREVIEW(["See, before anything is written, from &rarr; to,<br/>the price, and whether the calendar already knows it cannot go"])
    MOVEKEY(["Do the same without a pointer<br/>Move&hellip; in the drawer"])
    TYPESTATE(["Filter by Unit type and by state"])
  end

  subgraph OUT["Not this feature"]
    STARTEDGE(["Pull a booking's start, drag with a finger, scroll while dragging &mdash; RC-DEF-10 to RC-DEF-12"])
    ACT(["Check in, check out, cancel from the drawer &mdash; one home per command"])
    SAVED(["Named saved views &mdash; blueprint 18.6"])
    DATED(["A block with a start and an end &mdash; Maintenance (RANZ-33)"])
    CATEGORY(["Group by room category &mdash; there are none before rates (RANZ-31)"])
    CLOSEGAP(["Refuse a booking over an in-house Stay &mdash; the database does, since #60"])
  end

  DESK --> READ
  DESK --> WINDOW
  DESK --> SHAPE
  DESK --> DETAIL
  SETTER --> SETDEF
  RESIDENT -.->|never| READ

  READ -- "include" --> BARS
  READ -- "include" --> FREE
  READ -- "include" --> OVERLAPS
  READ -- "include" --> BLOCKS
  READ -- "include" --> LIVE
  WINDOW -- "extend" --> READ
  SHAPE -- "extend" --> READ
  ONLYOVER -- "extend" --> SHAPE
  REMEMBER -- "extend" --> READ
  DETAIL -- "include" --> ONWARD
  OPENDEF -- "extend" --> READ
  SETDEF --> OPENDEF

  AMENDER["Staff Member holding front_desk.amend<br/>with reach to the Property"]
  AMENDER --> DRAG
  AMENDER --> DRAGGUEST
  AMENDER --> MOVEKEY
  DESK --> TYPESTATE
  DRAG -- "include" --> PREVIEW
  DRAGGUEST -- "include" --> PREVIEW
  MOVEKEY -- "include" --> PREVIEW
  TYPESTATE -- "extend" --> SHAPE
