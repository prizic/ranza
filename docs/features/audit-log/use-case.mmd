%% Slices decide implementation order and nothing else:
%%   s1 the log, as far as the reader reaches   s2 one record   s3 name things
%%   s4 filter, search and page (ADR 0031)
%% A flowchart rather than usecase-beta: see .claude/skills/feature-design/SKILL.md step b.
%% UML directions: include points base --> included. extend points extension --> base.
%% Refusals are test cases, not use cases: they are rows in edge-cases.csv.
%% The one state is in states.mmd and is deliberately not repeated here.
flowchart TD

  SM["Staff Member<br/>holding audit.read, at a Property they reach"]

  subgraph S1["slice 1 &mdash; the log, as far as the reader reaches"]
    LIST(["Read what was done, by whom, where, and why<br/>newest first, the Properties they reach"])
    TRACE(["Trace a correction to its actor, amount and reason"])
    WHOLE(["See the whole Organization's records<br/>Organization-wide reach only"])
  end

  subgraph S2["slice 2 &mdash; one record"]
    ONE(["Open one record by id<br/>the whole reason and every fact, in the reader's language"])
  end

  subgraph S3["slice 3 &mdash; name things"]
    NAME(["See colleagues, Guests, rooms and roles by name<br/>resolved at read time, never stored"])
  end

  subgraph S4["slice 4 &mdash; filter, search and page"]
    FILTER(["Narrow by action, Property and day<br/>on the server, over every record"])
    SEARCH(["Find a Guest, a room, a colleague or a reason"])
    PAGE(["Page back to older records"])
  end

  subgraph OUT["Not this feature"]
    WRITE(["Writing a record &mdash; every module that acts already does"])
    REASON(["Requiring a reason &mdash; the correction that takes one already does"])
    EXPORT(["Export &mdash; Organization Data export, blueprint 3.6"])
    SIGNIN(["Sign-in events &mdash; security logging, blueprint 7.6"])
  end

  TRACE -- "extend" --> LIST
  WHOLE -- "extend" --> LIST
  ONE -- "extend" --> LIST
  NAME -- "extend" --> LIST
  NAME -- "extend" --> ONE
  FILTER -- "extend" --> LIST
  SEARCH -- "extend" --> LIST
  PAGE -- "extend" --> LIST

  SM --> LIST
  SM --> ONE

  LIST -. "depends on" .-> WRITE
  TRACE -. "depends on" .-> REASON

  %% DECIDED (ADR 0031): who may open the log is the audit.read permission —
  %% Owner and Manager by default, any role an Organization composes with it —
  %% and nothing commercial, because audit is a baseline right (blueprint 3.6).
  %% OPEN: where it sits in the rail. Blueprint 4.6 lists no Audit destination;
  %% it is drawn as its own destination because 3.6 makes audit a baseline right.
