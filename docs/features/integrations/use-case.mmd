%% Slices decide implementation order:
%%   s1 one integration, an outbound webhook: register an endpoint, deliver signed events, show failures, retry
%%   s2 not built: other connectors (INT-DEF-05), an endpoint per Property (INT-DEF-06), editing and rotating (INT-DEF-01/02)
%% Refusals and contention are test cases, not use cases: they are rows in edge-cases.csv.
%% State transitions are in states.mmd.
flowchart TD

  MANAGER["Staff Member holding integrations.manage<br/>with reach to the whole Organization"]
  PROPERTY_MANAGER["Staff Member holding integrations.manage<br/>at one Property"]
  VIEWER["Staff Member holding integrations.view<br/>monitors endpoints and failures"]
  OUTBOX["Transactional outbox<br/>facts published with the transaction that made them"]
  WORKER["Background worker (ranza_worker)<br/>queues, sends, records"]
  RECEIVER["Receiver<br/>the Organization's own HTTPS endpoint"]

  subgraph S1["slice 1 &mdash; one webhook, and its failures in view"]
    REGISTER(["Add endpoint<br/>name, https address, chosen events"])
    SECRET(["See the signing secret once"])
    TEST(["Send test event"])
    REMOVE(["Remove endpoint"])
    LIST(["View endpoints and open failures<br/>state in words, what the receiver answered,<br/>attempts, next attempt"])
    QUEUE(["Queue a delivery per subscribed endpoint<br/>built from the row the event names, frozen body;<br/>an event that does not match its row is a failure, not a send"])
    SEND(["Send signed JSON<br/>no redirects, no private addresses"])
    RECORD(["Record the outcome<br/>delivered, retry on schedule, or failed"])
    RETRY(["Retry now, or Retry all stopped"])
    CLOSED(["View closed failures, paged<br/>when, how, why and who in words"])
    CANCEL(["Stop retrying, with a reason"])
    RESOLVE(["Mark resolved, with a reason"])
  end

  subgraph S2["Not this slice"]
    CONNECTORS(["KBS, e-Arsiv, WhatsApp, payments, channel manager"])
    EDIT(["Edit an endpoint, rotate its secret"])
  end

  MANAGER --> REGISTER
  REGISTER --> SECRET
  MANAGER --> TEST
  MANAGER --> REMOVE
  MANAGER --> LIST
  PROPERTY_MANAGER --> LIST
  PROPERTY_MANAGER --> RETRY
  PROPERTY_MANAGER --> CANCEL
  PROPERTY_MANAGER --> RESOLVE
  VIEWER --> LIST
  VIEWER --> CLOSED
  PROPERTY_MANAGER --> CLOSED

  OUTBOX --> QUEUE
  TEST --> QUEUE
  QUEUE --> WORKER
  WORKER --> SEND
  SEND --> RECEIVER
  RECEIVER -- "2xx, 4xx, 5xx, silence" --> RECORD
  RECORD --> LIST
  RETRY --> QUEUE
  RECORD -- "a delivery that arrives" --> RESOLVE
