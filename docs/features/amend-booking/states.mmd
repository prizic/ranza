%% Anything not drawn here is forbidden.
%% Every transition carries its command and its slice.
%% Ids are prefixed because a state id is global in Mermaid.
%% An amendment changes a row's dates or Unit and never its status, so each is
%% a self-transition. Every one also appends a revision (reservation_changes),
%% which is append-only and has no states of its own.
%% Terminal states — checked out, cancelled, no-show, departed — accept no
%% amendment: history is corrected by a reversal, not rewritten (blueprint 7.4).
stateDiagram-v2
  direction LR

  state "public.reservations.status" as ReservationMachine {
    state "requested" as r_requested
    state "confirmed" as r_confirmed
    state "checked_in" as r_checked_in
    state "checked_out (terminal here)" as r_checked_out
    state "cancelled (terminal)" as r_cancelled
    state "no_show (terminal)" as r_no_show

    r_requested --> r_requested : amendBooking (dates, Unit) / s1
    r_confirmed --> r_confirmed : amendBooking (dates, Unit) / s1
    r_confirmed --> r_checked_in : checkIn / built
    r_checked_in --> r_checked_in : changeDeparture / s2 (its ends_on follows the Stay's)
    r_checked_in --> r_checked_in : moveGuest / s3 (its Unit follows the Stay's)
    r_checked_in --> r_checked_out : checkOut / built
    r_requested --> r_cancelled : cancelReservation / built
    r_confirmed --> r_cancelled : cancelReservation / built
    r_confirmed --> r_no_show : markNoShow / built
  }

  state "public.stays.status" as StayMachine {
    state "in_house" as s_in_house
    state "departed" as s_departed
    state "cancelled (terminal)" as s_cancelled

    [*] --> s_in_house : checkIn / built
    s_in_house --> s_in_house : changeDeparture / s2
    s_in_house --> s_in_house : moveGuest / s3
    s_in_house --> s_departed : checkOut / built
    s_in_house --> s_cancelled : reverseCheckIn / built
  }

  note right of r_confirmed
    A booking's nights are a range from arrival to departure.
    Its new nights must be free (the constraints decide),
    must not begin before today, and must not touch a closed day.
    Its price is kept, unless its Unit is of another kind:
    then it is today's price for that kind, shown before saving.
  end note

  note right of s_in_house
    Only the future moves: the nights already spent stay where they were.
    A departure is tomorrow or later (today is a check-out).
    A move changes the Unit from tonight; the Folio, the Stay and the price stay.
  end note
