# Runtime queries. In production this MUST be a pooled connection, and the role
# behind it MUST be RLS-subject — never an owner or a BYPASSRLS role, or every
# policy silently stops applying (ADR 0001). Locally that role is ranza_app,
# which the migration creates and `pnpm db:setup` gives a development password.
DATABASE_URL="postgresql://ranza_app:ranza_app@localhost:54322/ranza"

# Migrations and introspection only. A transaction-mode pooler cannot run DDL,
# so this must be a direct connection.
DIRECT_URL="postgresql://ranza:ranza@localhost:54322/ranza"

# When hosting on a provider with a transaction-mode pooler (Supabase, Neon,
# PgBouncer), the two differ. Supabase uses port 6543 for the pooler and 5432
# direct, and the pooled URL needs ?pgbouncer=true&connection_limit=1:
#
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Only `prisma migrate diff --from-migrations` reads this. It replays every
# migration into this database to work out what the migrations produce, which is
# how a hand-written index is proved to match schema.prisma. The database is
# dropped and recreated, so it must be a throwaway and never a database holding
# anything. Unset by default, and the command refuses to run rather than guess.
#
# SHADOW_DATABASE_URL="postgresql://ranza:ranza@localhost:54322/ranza_shadow"

# The background worker. A fourth role, and the separation is the point: it may
# set worker context and reach the outbox, and it is granted no execute on
# app.set_request_context(), so it cannot impersonate a Staff Member (ADR 0018).
# The worker refuses to start if this equals DIRECT_URL, or if the role behind it
# turns out to be a superuser, to carry BYPASSRLS, or to own a table.
WORKER_DATABASE_URL="postgresql://ranza_worker:ranza_worker@localhost:54322/ranza"

# Credentials. A separate role on the same database: ranza_auth reaches the
# auth_ tables, and the runtime role above is granted nothing on them, so a
# defect in the tenant query path cannot read password hashes (ADR 0005).
AUTH_DATABASE_URL="postgresql://ranza_auth:ranza_auth@localhost:54322/ranza"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
