# Public browser configuration. Values with this prefix are shipped to clients.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only configuration. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
ATTENDANCE_SCHEDULER_SECRET=
# Separate server-only bearer secret (at least 32 random characters).
RANZA_HEALTH_COLLECTOR_SECRET=
CONTROL_PLANE_ORIGIN=http://localhost:3002
RANZA_SCHEDULER_SECRET=
# Optional separate scheduler bearer secret for production deployment.
RANZA_SCHEDULER_SECRET=
# SENTRY_DSN=https://public-key@example.ingest.sentry.io/project-id

# Storefront intake fails closed until these are configured.
STOREFRONT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
LEAD_RATE_SECRET=
# Set only behind a proxy that overwrites this header; unset uses a global bucket.
LEAD_TRUSTED_IP_HEADER=

# Student activation fails closed until configured. Generate a random 32+ byte
# pepper; keep V1 stable after activation so existing PINs keep working.
PRODUCT_WEB_ORIGIN=http://localhost:3001
STUDENT_CREDENTIAL_PEPPER_V1=
WIFI_ENCRYPTION_KEY_V1=
# Set only when a trusted ingress overwrites this header. Unset = shared limit.
STUDENT_TRUSTED_IP_HEADER=
# Public Wi-Fi: use only an ingress-overwritten header; unset = shared 120/minute bucket.
PUBLIC_WIFI_TRUSTED_IP_HEADER=
