+export function RanzaLogo({
+  className,
+  monochrome = false,
+  variant = "horizontal",
+  ...props
+}: RanzaLogoProps) {
+  if (variant === "mark") {
+    return (
+      <svg
+        aria-label="Ranza"
+        className={className}
+        fill={monochrome ? "currentColor" : "#236740"}
+        role="img"
+        viewBox="0 0 1150 1150"
+        {...props}
+      >
+        <path d={MARK_PATH} fillRule="evenodd" />
+      </svg>
+    );
+  }
+
+  if (variant === "stacked") {
+    return (
+      <svg
+        aria-label="Ranza"
+        className={className}
+        fill="none"
+        role="img"
+        viewBox="0 0 1170 950"
+        {...props}
+      >
+        <path
+          d={S_MARK_PATH}
+          fill={monochrome ? "currentColor" : "#236740"}
+          fillRule="evenodd"
+        />
+        <path
+          d={S_LETTERS_PATH}
+          fill={monochrome ? "currentColor" : "#29333C"}
+          fillRule="evenodd"
+        />
+      </svg>
+    );
+  }
+
+  // Default: horizontal lockup
+  return (
+    <svg
+      aria-label="Ranza"
+      className={className}
+      fill="none"
+      role="img"
+      viewBox="0 0 1950 540"
+      {...props}
+    >
+      <path
+        d={H_MARK_PATH}
+        fill={monochrome ? "currentColor" : "#236740"}
+        fillRule="evenodd"
+      />
+      <path
+        d={H_LETTERS_PATH}
+        fill={monochrome ? "currentColor" : "#33363F"}
+        fillRule="evenodd"
+      />
+    </svg>
+  );
+}
