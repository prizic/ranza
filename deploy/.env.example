# Lives at /opt/apps/ranza/.env on the host — outside the source tree, which
# deploy/push.sh replaces wholesale. Never committed. Passwords are used inside
# connection URLs, so keep them URL-safe: `openssl rand -hex 24`. Compose reads
# this file and deploy/apply.sh sources it, so values stay unquoted, with no
# spaces, `#` or `$`.

# Public hostnames. Traefik issues the certificates; nip.io needs no DNS record.
WORKSPACE_HOST=ranza.178-105-194-50.nip.io
PORTAL_HOST=ranza-portal.178-105-194-50.nip.io

# The owner role. Migrations only — no application is ever given this.
POSTGRES_PASSWORD=

# The three runtime roles the migrations create without a password.
# deploy/apply.sh sets these on every deploy, so this file is their source of
# truth; change one here and the next deploy applies it.
RANZA_APP_PASSWORD=
RANZA_AUTH_PASSWORD=
RANZA_WORKER_PASSWORD=

# Shared by the Workspace and the Portal: one auth database, one secret,
# two origins. `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
